{
  "manifest_version": 3,
  "name": "yt-dlp Downloader",
  "version": "0.3.0",
  "description": "Download the video on the current tab with your local yt-dlp helper, at any quality.",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "popup.html",
    "default_title": "yt-dlp Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "storage", "alarms", "notifications", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:4599/*"]
}
